# AccessLens backend configuration.
#
# Copy to `.env` and adjust. Every variable is prefixed ACCESSLENS_ and is read
# by `app.core.config.Settings`; nothing here is read directly by application
# code, so this file and that class are the only two places to look.

# --- analysis window -------------------------------------------------------- #
# The instant the analysis pretends "now" is. Leave it UNSET for real data: the
# window then ends at the current time, which is what a live deployment wants.
#
# It is PINNED here because the bundled fixtures in `data/` are a dated,
# hand-built set anchored to 2026-09-29. Without a pin the 90-day window slides
# forward every day, the fixtured events fall out of it one by one, and the
# demo quietly changes from "here are the findings" to "everyone is clean" --
# a failure that looks like success. Set this to the fixture set's date.
ACCESSLENS_ANALYSIS_AS_OF=2026-09-29T06:00:00Z

# Length of the lookback window, ending at the instant above.
ACCESSLENS_LOOKBACK_DAYS=90

# --- data ------------------------------------------------------------------- #
# Directory holding the fixture feeds (stand-ins for Workday, Okta, AWS and
# GitHub). Resolved relative to the repository root when not absolute. Read-only
# input: the application never writes here.
# ACCESSLENS_DATA_DIR=data

# --- persistence ------------------------------------------------------------ #
# SQLite by default. Every model uses portable SQLAlchemy types only, so
# PostgreSQL is a URL change with no code change:
#   ACCESSLENS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/accesslens
ACCESSLENS_DATABASE_URL=sqlite+pysqlite:///./accesslens.db

# Run ingestion during startup. Turn off to serve an existing database without
# re-reading the feeds.
ACCESSLENS_AUTO_INGEST_ON_STARTUP=true

# --- application ------------------------------------------------------------ #
ACCESSLENS_ENVIRONMENT=local
ACCESSLENS_DEBUG=false
ACCESSLENS_LOG_LEVEL=INFO

# --- thresholds (consumed by the Phase 2 engine) ---------------------------- #
# Fraction of granted capabilities a user must exercise to count as active. A
# user below this with privileged access is a review candidate, never an
# automatic removal.
ACCESSLENS_LOW_UTILIZATION_THRESHOLD=0.25

# Minimum successful events before low usage is asserted at all. Below this the
# evidence is too thin to call, whatever the ratio says.
ACCESSLENS_MIN_OBSERVED_EVENTS_FOR_CONFIDENCE=3

# --- CORS ------------------------------------------------------------------- #
# Only needed for browser-side calls. The Phase 1 page fetches server-side, so
# this is unused today and present for the Phase 3 dashboard.
# ACCESSLENS_CORS_ORIGINS=["http://localhost:3000"]
